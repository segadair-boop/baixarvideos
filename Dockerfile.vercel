# Vercel Container Functions: FFmpeg e yt-dlp como dependências do sistema.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend /app/backend
RUN mkdir -p /tmp/baixarvideos && useradd -m -u 10001 appuser && chown -R appuser:appuser /tmp/baixarvideos /app
USER appuser
EXPOSE 8080
CMD ["sh","-c","exec uvicorn backend.main:app --host 0.0.0.0 --port $(printenv PORT || echo 8080) --workers 1"]
